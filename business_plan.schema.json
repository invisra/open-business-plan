{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.invisra.ai/business-plan/1.0.0/business_plan.schema.json",
    "title": "BusinessPlan",
    "description": "An Open Source JSON Schema that defines a Business Plan.",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "description": "The unique identifier of the business",
            "minimum": 1
        },
        "name": {
            "type": "string",
            "description": "The common name of the business"
        },
        "filed_name": {
            "type": "string",
            "description": "The registered/legal name of the business"
        },
        "tagline": {
            "type": "string",
            "description": "The tagline of the business"
        },
        "logo_link": {
            "type": "string",
            "description": "A link to the logo of the business",
            "format": "uri"
        },
        "domain": {
            "type": "string",
            "description": "The web domain of the business",
            "format": "hostname"
        },
        "organization": {
            "type": "array",
            "title": "Organization",
            "description": "A list of the key members of the business",
            "uniqueItems": true,
            "minItems": 1,
            "items": { "$ref": "#/$defs/member" }
        },
        "date_started": { "$ref": "#/$defs/date" },
        "plan": {
            "type": "object",
            "title": "Plan",
            "additionalProperties": false,
            "properties": {
                "mission_statement": {
                    "type": "string",
                    "description": "The mission statement for the business"
                },
                "vision_statement": {
                    "type": "string",
                    "description": "The vision statement for the business"
                },
                "executive_summary": {
                    "type": "object",
                    "title": "ExecutiveSummary",
                    "additionalProperties": false,
                    "properties": {
                        "overview": {
                            "type": "string",
                            "description": "The overview of the executive summary of the business plan"
                        },
                        "objectives": {
                            "type": "array",
                            "title": "Objectives",
                            "description": "The objectives of the business",
                            "uniqueItems": true,
                            "items": { "$ref": "#/$defs/namedDescription" }
                        }
                    },
                    "required": [ "overview" ]
                },
                "market_analysis": {
                    "type": "object",
                    "title": "MarketAnalysis",
                    "description": "The analysis of the market of the business",
                    "additionalProperties": false,
                    "properties": {
                        "target_market": {
                            "type": "string",
                            "description": "A description of the business's target market"
                        },
                        "industry_trends": {
                            "type": "array",
                            "description": "Trends in the business's industry",
                            "items": { "type": "string" }
                        },
                        "competitors": {
                            "type": "array",
                            "description": "Known competitors of the business",
                            "items": { "$ref": "#/$defs/competitor" }
                        },
                        "customer_demographics": {
                            "type": "array",
                            "description": "Demographic characteristics of the business's customers",
                            "items": { "type": "string" }
                        },
                        "swot_analysis": { "$ref": "#/$defs/swotAnalysis" }
                    }
                },
                "marketing_plan": {
                    "type": "object",
                    "title": "MarketingPlan",
                    "description": "The plan for marketing for the business",
                    "additionalProperties": false,
                    "properties": {
                        "unique_value_proposition": {
                            "type": "string",
                            "description": "What sets the business apart from its competitors"
                        },
                        "pricing_strategy": {
                            "type": "string",
                            "description": "How the business's products or services are priced"
                        },
                        "promotion_channels": {
                            "type": "array",
                            "description": "The channels used to promote the business, e.g. social media, email, print",
                            "items": { "type": "string" }
                        },
                        "sales_strategy": {
                            "type": "string",
                            "description": "How the business plans to sell its products or services"
                        },
                        "branding_strategy": {
                            "type": "string",
                            "description": "How the business plans to build and maintain its brand"
                        }
                    }
                },
                "financial_plan": {
                    "type": "object",
                    "title": "FinancialPlan",
                    "description": "The financial plan for the business",
                    "additionalProperties": false,
                    "properties": {
                        "startup_costs": {
                            "type": "array",
                            "description": "One-time costs required to launch the business",
                            "items": { "$ref": "#/$defs/lineItem" }
                        },
                        "funding_sources": {
                            "type": "array",
                            "description": "Sources of funding for the business, e.g. personal savings, loans, investors",
                            "items": { "$ref": "#/$defs/lineItem" }
                        },
                        "revenue_streams": {
                            "type": "array",
                            "description": "The ways the business generates revenue",
                            "items": { "type": "string" }
                        },
                        "revenue_projections": {
                            "type": "array",
                            "description": "Projected revenue by year",
                            "items": { "$ref": "#/$defs/yearlyProjection" }
                        },
                        "expense_projections": {
                            "type": "array",
                            "description": "Projected expenses by year",
                            "items": { "$ref": "#/$defs/yearlyProjection" }
                        },
                        "break_even_point": {
                            "type": "string",
                            "description": "A description of when/how the business expects to break even"
                        }
                    }
                },
                "operations_plan": {
                    "type": "object",
                    "title": "OperationsPlan",
                    "description": "The operations plan for the business",
                    "additionalProperties": false,
                    "properties": {
                        "location": {
                            "type": "string",
                            "description": "Where the business operates from"
                        },
                        "facilities": {
                            "type": "string",
                            "description": "A description of the facilities used by the business"
                        },
                        "equipment": {
                            "type": "array",
                            "description": "Equipment used by the business",
                            "items": { "type": "string" }
                        },
                        "suppliers": {
                            "type": "array",
                            "description": "Suppliers or vendors the business relies on",
                            "items": { "$ref": "#/$defs/namedDescription" }
                        },
                        "staffing_plan": {
                            "type": "array",
                            "description": "The roles the business needs to staff",
                            "items": { "$ref": "#/$defs/staffingRole" }
                        },
                        "workflow": {
                            "type": "string",
                            "description": "A description of the business's day-to-day operational workflow"
                        }
                    }
                },
                "core_values": {
                    "type": "array",
                    "title": "CoreValues",
                    "description": "A list of values for the business",
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/namedDescription" }
                },
                "naics_categories": {
                    "type": "array",
                    "title": "NaicsCategories",
                    "description": "A list of NAICS categories for the business's services",
                    "items": { "$ref": "#/$defs/naicsCategory" }
                }
            },
            "required": [ "mission_statement", "vision_statement", "executive_summary", "core_values", "naics_categories" ]
        }
    },
    "required": [ "name", "filed_name", "tagline", "domain", "organization", "date_started", "plan" ],
    "$defs": {
        "member": {
            "type": "object",
            "title": "Member",
            "description": "A key member of the business",
            "additionalProperties": false,
            "properties": {
                "first_name": {
                    "type": "string",
                    "description": "The first name of the member of the business"
                },
                "last_name": {
                    "type": "string",
                    "description": "The last name of the member of the business"
                },
                "role": {
                    "type": "string",
                    "description": "The role of the member of the business"
                },
                "email": {
                    "type": "string",
                    "description": "The email address of the member of the business",
                    "format": "email"
                }
            },
            "required": [ "first_name", "last_name", "role" ]
        },
        "date": {
            "type": "object",
            "title": "Date",
            "additionalProperties": false,
            "properties": {
                "year": {
                    "type": "integer",
                    "description": "The year"
                },
                "month": {
                    "type": "integer",
                    "description": "The month",
                    "minimum": 1,
                    "maximum": 12
                },
                "day": {
                    "type": "integer",
                    "description": "The day",
                    "minimum": 1,
                    "maximum": 31
                }
            },
            "required": [ "year" ]
        },
        "namedDescription": {
            "type": "object",
            "title": "NamedDescription",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "A short name or title"
                },
                "description": {
                    "type": "string",
                    "description": "A description"
                }
            },
            "required": [ "name", "description" ]
        },
        "competitor": {
            "type": "object",
            "title": "Competitor",
            "description": "A known competitor of the business",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "The name of the competitor"
                },
                "strengths": {
                    "type": "array",
                    "description": "The competitor's strengths",
                    "items": { "type": "string" }
                },
                "weaknesses": {
                    "type": "array",
                    "description": "The competitor's weaknesses",
                    "items": { "type": "string" }
                }
            },
            "required": [ "name" ]
        },
        "swotAnalysis": {
            "type": "object",
            "title": "SwotAnalysis",
            "description": "A SWOT (Strengths, Weaknesses, Opportunities, Threats) analysis",
            "additionalProperties": false,
            "properties": {
                "strengths": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "weaknesses": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "opportunities": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "threats": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            }
        },
        "lineItem": {
            "type": "object",
            "title": "LineItem",
            "description": "A named financial line item",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "The name of the line item, e.g. 'Equipment' or 'Angel investment'"
                },
                "amount": {
                    "type": "number",
                    "description": "The amount in the business's base currency",
                    "minimum": 0
                },
                "description": {
                    "type": "string",
                    "description": "Additional detail about the line item"
                }
            },
            "required": [ "name", "amount" ]
        },
        "yearlyProjection": {
            "type": "object",
            "title": "YearlyProjection",
            "additionalProperties": false,
            "properties": {
                "year": {
                    "type": "integer",
                    "description": "The year the projection applies to"
                },
                "amount": {
                    "type": "number",
                    "description": "The projected amount in the business's base currency",
                    "minimum": 0
                }
            },
            "required": [ "year", "amount" ]
        },
        "staffingRole": {
            "type": "object",
            "title": "StaffingRole",
            "additionalProperties": false,
            "properties": {
                "role": {
                    "type": "string",
                    "description": "The name of the role, e.g. 'Warehouse Associate'"
                },
                "count": {
                    "type": "integer",
                    "description": "The number of people needed in the role",
                    "minimum": 0
                },
                "description": {
                    "type": "string",
                    "description": "A description of the role's responsibilities"
                }
            },
            "required": [ "role", "count" ]
        },
        "naicsCategory": {
            "type": "object",
            "title": "NaicsCategory",
            "additionalProperties": false,
            "properties": {
                "code": {
                    "type": "string",
                    "description": "A NAICS code for a business service",
                    "pattern": "^[0-9]{2,6}$"
                },
                "description": {
                    "type": "string",
                    "description": "The description of the service"
                }
            },
            "required": [ "code", "description" ]
        }
    }
}
